# SIEM Insider Threat Detection Platform - Environment Configuration

# Server & Network Configuration
PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=siem_soc_jwt_secure_secret_key_2026

# Security & Abuse Detection Thresholds
# Maximum repeated sign-up attempts before triggering high-severity abuse alert
SIGNUP_ATTEMPT_THRESHOLD=3
# Window in seconds for evaluating sign-up velocity (e.g., 300 = 5 minutes)
SIGNUP_WINDOW_SECONDS=300

# Maximum failed file downloads before triggering DLP security alert
FAILED_DOWNLOAD_THRESHOLD=3
# Window in seconds for evaluating failed download velocity (e.g., 300 = 5 minutes)
FAILED_DOWNLOAD_WINDOW_SECONDS=300

# SIEM & DLP Thresholds
# Maximum external USB drive transfer quota in MB before blocking
USB_TRANSFER_THRESHOLD_MB=500
# Large file egress alert threshold in MB
LARGE_FILE_THRESHOLD_MB=500

# Database Persistence File Path (defaults to ./data/siem_database.json)
DATABASE_FILE_PATH=./data/siem_database.json

# Gemini AI API Key (Optional for server-side threat narrative generation)
GEMINI_API_KEY=
